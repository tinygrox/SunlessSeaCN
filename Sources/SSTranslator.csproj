<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SunlessSeaChineseTranslation</AssemblyName>
    <Description>Sunless Sea Chinese Translation</Description>
    <OutputType>Library</OutputType>
    <Version>6.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <OutputPath>$(GamePath)\BepInEx\plugins\SunlessSeaChineseTranslation</OutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PackageOutputPath />
    <PackAsTool>False</PackAsTool>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
    <WarningLevel>4</WarningLevel>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <WarningLevel>4</WarningLevel>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="$(GamePath)\BepInEx\core\0Harmony.dll" Private="False"/>
    <Reference Include="$(GamePath)\BepInEx\core\BepInEx.Preloader.dll" Private="False"/>
    <Reference Include="$(GamePath)\BepInEx\core\BepInEx.dll" Private="False"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GamePath)\Sunless Sea_Data\Managed\Failbetter.Core.dll" Private="False"/>
    <Reference Include="$(GamePath)\Sunless Sea_Data\Managed\JsonFx.dll" Private="False"/>
    <Reference Include="$(GamePath)\Sunless Sea_Data\Managed\Sunless.Game.dll" Private="False" />
    <Reference Include="$(GamePath)\Sunless Sea_Data\Managed\Unity*" Private="False"/>
  </ItemGroup>
</Project>
